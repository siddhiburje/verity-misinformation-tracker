# ==========================================================
# Verity backend — environment configuration
# Copy this file to ".env" in the backend/ folder and fill
# in real values. NEVER commit the real ".env" file to Git.
# ==========================================================

# --- Flask / security -------------------------------------
# Random secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
FLASK_SECRET_KEY=change-this-to-a-different-long-random-string

# Environment: "development" or "production"
FLASK_ENV=development

# --- Database ------------------------------------------------
# SQLite is used by default (zero-config, file-based).
# The path is relative to backend/instance/.
DATABASE_URL=sqlite:///verity.db

# --- News API --------------------------------------------------
# Get a free key at https://newsapi.org/register
# Required for the "live news search" feature. If this is left
# blank, the app automatically falls back to a small clearly
# labelled offline sample dataset instead of pretending to be live.
NEWSAPI_KEY=

# --- Fact Check API ------------------------------------------------
# Get a free key at https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
# (enable "Fact Check Tools API" on a Google Cloud project). Used by
# the Claim Verification feature to look up existing fact-checks for a
# submitted claim. If this is left blank, verification always returns
# "Unverified" with an honest explanation instead of guessing.
FACTCHECK_API_KEY=

# --- OCR (optional) -----------------------------------------------
# Only needed if Tesseract isn't on your PATH and isn't in one of the
# default install locations this project already checks automatically
# (see README section 4a for Windows). Full path to the tesseract
# binary, e.g. on Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- CORS --------------------------------------------------------
# Origin(s) allowed to call the API, comma separated.
# Not needed if you serve frontend + backend from the same Flask
# app (the default setup in this project), but kept here in case
# the frontend is later split onto its own dev server/port.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
